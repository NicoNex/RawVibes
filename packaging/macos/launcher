#!/bin/sh
# Points GTK at the runtime data bundled in the .app (no Homebrew needed).
contents="$(cd "$(dirname "$0")/.." && pwd)"
export XDG_DATA_DIRS="$contents/share"
export GSETTINGS_SCHEMA_DIR="$contents/share/glib-2.0/schemas"
cache="${TMPDIR:-/tmp}/rawvibes-pixbuf-loaders.cache"
sed "s|@CONTENTS@|$contents|g" "$contents/Resources/loaders.cache.in" > "$cache"
export GDK_PIXBUF_MODULE_FILE="$cache"
exec "$contents/MacOS/rawvibes-bin" "$@"
