# Maintainer: Nicolò Santamaria <nicolo.santamaria@gmail.com>
# One package per interface, each with the data it needs: `make arch` builds rawvibes (GTK),
# `make arch-qt` builds rawvibes-qt (Qt 6). RAWVIBES_UI picks which (gtk by default).
_ui=${RAWVIBES_UI:-gtk}
pkgbase=rawvibes
if [[ $_ui == qt ]]; then
  pkgname=rawvibes-qt
  _crate=rawvibes-qt
  pkgdesc="RAW photo editor with color grading, 3D LUT export and HDR preview, GPU accelerated (Qt 6)"
  depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'vulkan-icd-loader' 'libjxl')
  optdepends=('qt6-wayland: native Wayland windows')
  _uideps=('qt6-base' 'qt6-declarative')
else
  pkgname=rawvibes
  _crate=rawvibes
  pkgdesc="RAW photo editor with color grading and 3D LUT export, GPU accelerated (GTK 4)"
  depends=('gtk4' 'libadwaita' 'vulkan-icd-loader' 'libjxl')
  _uideps=('gtk4' 'libadwaita')
fi
# Both carry the same translations, icons, lens database and models; the old shared package goes.
conflicts=('rawvibes-common' "$([[ $_ui == qt ]] && echo rawvibes || echo rawvibes-qt)")
pkgver=0.1.0
pkgrel=1
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
makedepends=('cargo' 'cmake' 'nasm' 'gettext' 'unzip' 'python-onnx' 'python-numpy' 'lensfun'
             'vulkan-icd-loader' 'libjxl' "${_uideps[@]}")
options=('!lto' '!debug')
# Tarball produced by `make arch` / `make arch-qt` from the committed HEAD.
# The AI denoise weights darktable ships, converted at build time (models/README.md).
source=("$pkgbase-$pkgver.tar.gz"
        "https://github.com/darktable-org/darktable-ai/releases/download/release-5.6.0/rawdenoise-nind.dtmodel")
noextract=('rawdenoise-nind.dtmodel')
sha256sums=('SKIP'
            'd71b5f1e727c85a359e6f74dca9e2016c9d8fc3e2f7ac3e9b347d80ceca969af')

prepare() {
  cd "$pkgbase-$pkgver"
  # git archive stamps files with the commit date, older than the cached target/: cargo and make would skip them.
  find . -path ./target -prune -o -type f -exec touch {} +
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgbase-$pkgver"
  export CARGO_TARGET_DIR=target
  # Only this interface: the other one's toolkit need not be installed.
  cargo build --frozen --release -p "$_crate"
  install -Dm644 "$srcdir/rawdenoise-nind.dtmodel" target/models/rawdenoise-nind.dtmodel
  make models locale lensfun
}

check() {
  cd "$pkgbase-$pkgver"
  cargo test --frozen --release -p rawvibes-core -p "$_crate"
}

package() {
  cd "$pkgbase-$pkgver"
  make install-data "install-$_ui" DESTDIR="$pkgdir" PREFIX=/usr
}
