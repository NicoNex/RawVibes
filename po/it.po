#: gtk/src/main.rs:3208 qt/qml/GradePage.qml:165
msgid "Lum vs Sat"
msgstr "Lum./Sat."

#: gtk/src/main.rs:3211 qt/qml/GradePage.qml:166
msgid ""
"The middle line is no change. Pull a hue up or down to shift it, saturate or "
"desaturate it; Lum vs Sat works by brightness."
msgstr ""
"La linea centrale non cambia nulla. Alza o abbassa una tonalità per "
"spostarla, saturarla o desaturarla; Lum./Sat. agisce in base alla luminosità."

#: gtk/src/main.rs:3215 qt/qml/GradePage.qml:159
msgid "Hue curves"
msgstr "Curve di tonalità"

#: gtk/src/main.rs:3220 qt/qml/GradePage.qml:85
